# Copy to .env.local and fill in from Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# These values identify the project; they are not secrets. Access is
# controlled by security rules and App Check, never by hiding these.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pas-dev-7786f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pas-dev-7786f
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pas-dev-7786f.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to talk to the local Firebase emulators instead of the cloud.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Story photos are stored privately at Cloudinary (free plan). From the
# Cloudinary console: Settings > API Keys. SECRET: server-only, never give
# these a NEXT_PUBLIC_ prefix and never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. The site's public address for search engines and link previews.
# On Vercel it comes from the production domain automatically.
NEXT_PUBLIC_SITE_URL=
