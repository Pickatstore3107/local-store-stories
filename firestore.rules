rules_version = '2';

// Everything is denied unless a rule below allows it.
// Tests for every rule live in tests/rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Must match CONSENT_VERSION in src/lib/consent.ts.
    function currentConsentVersion() {
      return '2026-10-v1';
    }

    function isModerator() {
      return signedIn()
        && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    // Moderators are added by hand in the Firebase console, never by the app.
    // People may check whether they are one; nobody can make themselves one.
    match /moderators/{uid} {
      allow get: if isOwner(uid);
    }

    // Public profile. Anyone may read one profile; nobody may list them all.
    match /users/{uid} {
      function validProfile(data) {
        return isText(data.displayName, 1, 40)
          && isText(data.city, 2, 60)
          && data.updatedAt == request.time;
      }

      allow get: if true;

      // Created together with the consent record, in one batch.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'city', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['displayName', 'city', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == request.time
        && validProfile(request.resource.data)
        && existsAfter(/databases/$(database)/documents/usersPrivate/$(uid));

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'city', 'updatedAt'])
        && validProfile(request.resource.data);

      allow delete: if isOwner(uid);
    }

    // Private consent record. Only its owner can read it.
    match /usersPrivate/{uid} {
      function validConsent(data) {
        return data.keys().hasOnly(['consentVersion', 'consentAt', 'ageConfirmed'])
          && data.keys().hasAll(['consentVersion', 'consentAt', 'ageConfirmed'])
          && data.consentVersion == currentConsentVersion()
          && data.ageConfirmed == true
          && data.consentAt == request.time;
      }

      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && validConsent(request.resource.data);
      allow delete: if isOwner(uid);

      // The memories this person loved. Only they can see these; a memory's
      // author sees how many people loved it, never who.
      match /reactions/{storyId} {
        function story() {
          return /databases/$(database)/documents/stories/$(storyId);
        }

        function loves(storyDoc) {
          return storyDoc.data.get('reactionCount', 0);
        }

        allow get, list: if isOwner(uid);

        // Written in the same batch as the memory's count (checked there too).
        allow create: if isOwner(uid)
          && exists(/databases/$(database)/documents/usersPrivate/$(uid))
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && loves(getAfter(story())) == loves(get(story())) + 1;

        // Once the memory is deleted there is no count left to change.
        allow delete: if isOwner(uid)
          && (!exists(story()) || loves(getAfter(story())) == loves(get(story())) - 1);
      }
    }

    // A memory of a store. The author creates it as pending; only a moderator
    // can change its status, and only an approved story is ever public.
    match /stories/{storyId} {
      function isAuthor() {
        return signedIn() && resource.data.authorId == request.auth.uid;
      }

      function optionalText(data, key, min, max) {
        return !(key in data) || isText(data[key], min, max);
      }

      // Must match CATEGORIES in src/lib/stories.ts.
      function categories() {
        return ['Tea Stalls', 'Bakeries', 'School Canteens', 'Kirana Stores', 'Bookstores',
          '₹10 Treats', 'Festival Memories', 'Family Traditions', 'Local Legends',
          'Stores We Miss'];
      }

      function validNewStory(data) {
        return data.keys().hasOnly(['authorId', 'storeName', 'category', 'city',
            'neighbourhood', 'caption', 'year', 'ordered', 'visibility',
            'rightsConfirmed', 'status', 'photoId', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['authorId', 'storeName', 'category', 'city', 'caption',
            'visibility', 'rightsConfirmed', 'status', 'photoId', 'createdAt', 'updatedAt'])
          && data.authorId == request.auth.uid
          && isText(data.storeName, 2, 80)
          && data.category in categories()
          && isText(data.city, 2, 60)
          && optionalText(data, 'neighbourhood', 2, 60)
          && isText(data.caption, 10, 1000)
          && optionalText(data, 'ordered', 1, 80)
          && (!('year' in data)
              || (data.year is int && data.year >= 1940 && data.year <= request.time.year()))
          && data.visibility in ['public', 'link']
          && data.rightsConfirmed == true
          && data.status == 'pending'
          // The photo's ID at Cloudinary; must match photoId() in src/lib/server/photos.ts.
          && data.photoId == 'lss/stories/' + request.auth.uid + '/' + storyId
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      // Where a moderator may move a story from each status.
      // Must match REVIEW_MOVES in src/lib/moderation.ts.
      function reviewMoves() {
        return {
          'pending': ['approved', 'rejected'],
          'approved': ['hidden'],
          'rejected': ['approved'],
          'hidden': ['approved']
        };
      }

      function logEntry(id) {
        return /databases/$(database)/documents/moderationLog/$(id);
      }

      // A moderator's decision. It changes only the review fields, and is
      // written to the moderation log in the same batch.
      function validReview(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys()
               .hasOnly(['status', 'reviewedAt', 'reviewNote', 'reviewLogId', 'updatedAt'])
          && after.status in reviewMoves().get(before.status, [])
          // The author is told why a story was not approved or was hidden.
          // Must match REVIEW_NOTE_MIN and REVIEW_NOTE_MAX in src/lib/moderation.ts.
          && (after.status == 'approved'
              ? !('reviewNote' in after)
              : isText(after.reviewNote, 5, 300))
          && after.reviewedAt == request.time
          && after.updatedAt == request.time
          && after.reviewLogId is string
          && !exists(logEntry(after.reviewLogId))
          && getAfter(logEntry(after.reviewLogId)).data.storyId == storyId
          && getAfter(logEntry(after.reviewLogId)).data.action == after.status;
      }

      // A moderator picks memories for the Featured row on the Wall, or
      // takes them out of it.
      function validFeature(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['featuredAt'])
          && (!('featuredAt' in after)
              || (after.featuredAt == request.time
                  && before.status == 'approved'
                  && before.visibility == 'public'));
      }

      function myReaction() {
        return /databases/$(database)/documents/usersPrivate/$(request.auth.uid)/reactions/$(storyId);
      }

      // Loving a memory adds one to its count, in the same batch as the
      // person's private reaction record; taking it back takes one away.
      function validReactionCount(before, after) {
        return signedIn()
          && after.diff(before).affectedKeys().hasOnly(['reactionCount'])
          && ((after.reactionCount == before.get('reactionCount', 0) + 1
                && before.status == 'approved'
                && !exists(myReaction())
                && existsAfter(myReaction()))
            || (after.reactionCount == before.get('reactionCount', 0) - 1
                && exists(myReaction())
                && !existsAfter(myReaction())));
      }

      // Only people who have given consent can share.
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/usersPrivate/$(request.auth.uid))
        && validNewStory(request.resource.data);

      // Anyone can open an approved story; the Wall lists only those shared
      // with everyone. Authors always see their own, moderators see all.
      allow get: if resource.data.status == 'approved' || isAuthor() || isModerator();
      allow list: if (resource.data.status == 'approved' && resource.data.visibility == 'public')
        || isAuthor()
        || isModerator();

      allow update: if validReview(resource.data, request.resource.data)
        || validFeature(resource.data, request.resource.data)
        || validReactionCount(resource.data, request.resource.data);
      allow delete: if isAuthor();
    }

    // Every moderation decision, for accountability. Moderators can read it;
    // nobody can change or delete an entry. The moderator's ID lives only
    // here, never on the story, so authors can't see who reviewed them.
    match /moderationLog/{logId} {
      function story(id) {
        return /databases/$(database)/documents/stories/$(id);
      }

      function validEntry(entry) {
        return entry.keys().hasOnly(['storyId', 'storeName', 'action', 'from', 'by', 'at', 'note'])
          && entry.keys().hasAll(['storyId', 'storeName', 'action', 'from', 'by', 'at'])
          && entry.storyId is string
          && entry.by == request.auth.uid
          && entry.at == request.time
          // Written together with the story's change (checked there too).
          && getAfter(story(entry.storyId)).data.reviewLogId == logId
          && entry.from == get(story(entry.storyId)).data.status
          && entry.storeName == getAfter(story(entry.storyId)).data.storeName
          && entry.get('note', null) == getAfter(story(entry.storyId)).data.get('reviewNote', null);
      }

      allow get, list: if isModerator();
      allow create: if isModerator() && validEntry(request.resource.data);
    }

    // A report about a memory on the Wall. Each person can report a memory
    // once. Moderators read reports and close them; the memory's author never
    // sees who reported it.
    match /reports/{reportId} {
      function story(id) {
        return /databases/$(database)/documents/stories/$(id);
      }

      // Must match REPORT_REASONS in src/lib/reports.ts.
      function reasons() {
        return ['unkind', 'private', 'notStore', 'rights', 'other'];
      }

      // Must match REPORT_DETAILS_MIN and REPORT_DETAILS_MAX in src/lib/reports.ts.
      function validReport(report) {
        return report.keys().hasOnly(['storyId', 'reason', 'details', 'by', 'at', 'status'])
          && report.keys().hasAll(['storyId', 'reason', 'by', 'at', 'status'])
          && report.storyId is string
          && reportId == report.storyId + '_' + request.auth.uid
          && report.reason in reasons()
          // "Something else" needs a few words; other reasons may add some.
          && (report.reason == 'other'
              ? isText(report.get('details', null), 5, 500)
              : (!('details' in report) || isText(report.details, 1, 500)))
          && report.by == request.auth.uid
          && report.at == request.time
          && report.status == 'open'
          && get(story(report.storyId)).data.status == 'approved';
      }

      // A moderator closes a report once the memory is hidden, kept up after
      // a look, or gone because its author deleted it.
      function validClose(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['status', 'outcome', 'closedBy', 'closedAt'])
          && before.status == 'open'
          && after.status == 'closed'
          && after.closedBy == request.auth.uid
          && after.closedAt == request.time
          && (after.outcome == 'gone'
              ? !existsAfter(story(before.storyId))
              : (after.outcome in ['hidden', 'kept']
                 && getAfter(story(before.storyId)).data.status
                      == (after.outcome == 'hidden' ? 'hidden' : 'approved')));
      }

      // Only people who have given consent can report.
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/usersPrivate/$(request.auth.uid))
        && validReport(request.resource.data);

      // People can find and take back their own reports, for example when
      // they delete their account.
      allow get: if isModerator();
      allow list: if isModerator() || (signedIn() && resource.data.by == request.auth.uid);
      allow update: if validClose(resource.data, request.resource.data);
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
  }
}
