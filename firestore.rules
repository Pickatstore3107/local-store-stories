rules_version = '2';

// Everything is denied unless a rule below allows it.
// Tests for every rule live in tests/rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Must match CONSENT_VERSION in src/lib/consent.ts.
    function currentConsentVersion() {
      return '2026-10-v4';
    }

    function isModerator() {
      return signedIn()
        && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    // Links are the usual sign of spam, so comments and bios can't have them.
    // Must match hasLink() in src/lib/comments.ts.
    function noLinks(text) {
      return !text.lower().matches('(?s).*(https?://|www[.]).*');
    }

    // Moderators are added by hand in the Firebase console, never by the app.
    // People may check whether they are one; nobody can make themselves one.
    match /moderators/{uid} {
      allow get: if isOwner(uid);
    }

    // Public profile. Anyone may read one profile. Members may search them
    // by name, 20 at a time; nobody may list them all at once.
    match /users/{uid} {
      function photoReview() {
        return /databases/$(database)/documents/photoReviews/$(uid);
      }

      // nameLower is the name in small letters without accents, for
      // searching by name (searchName() in src/lib/people.ts). The rules
      // can't make it the same way, so the search checks each result's name.
      // The bio shows at once; anyone can report it. Must match BIO_MAX in
      // src/lib/profiles.ts.
      function validProfile(data) {
        return isText(data.displayName, 1, 40)
          && isText(data.city, 2, 60)
          && (!('nameLower' in data) || isText(data.nameLower, 1, 80))
          && (!('bio' in data) || (isText(data.bio, 1, 150) && noLinks(data.bio)))
          && data.updatedAt == request.time;
      }

      // A signed link to the photo, in a size, as src/lib/server/avatars.ts
      // makes them.
      function photoLink(url, id) {
        return url is string
          && url.matches('https://res[.]cloudinary[.]com/[A-Za-z0-9_-]+/image/authenticated/s--[A-Za-z0-9_-]{8,32}--/[a-z0-9_,]+/v1/' + id + '[.]jpg');
      }

      // A moderator puts up the photo waiting in the person's review, and
      // removes the review in the same batch.
      function validPhotoApproval(before, after) {
        let review = get(photoReview()).data;
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['photo'])
          && review.status == 'waiting'
          && !existsAfter(photoReview())
          && after.photo is map
          && after.photo.keys().hasOnly(['id', 'small', 'large'])
          && after.photo.keys().hasAll(['id', 'small', 'large'])
          && after.photo.id == review.photoId
          && photoLink(after.photo.small, review.photoId)
          && photoLink(after.photo.large, review.photoId);
      }

      // After a report, a moderator may remove the bio or the photo, or
      // change the name to "Member". Nothing else.
      function validModeratorChange(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['bio', 'photo', 'displayName', 'nameLower'])
          && (!('bio' in after) || after.bio == before.get('bio', null))
          && (!('photo' in after) || after.photo == before.get('photo', null))
          && ((after.displayName == before.displayName
               && after.get('nameLower', null) == before.get('nameLower', null))
              || (after.displayName == 'Member' && after.get('nameLower', null) == 'member'));
      }

      // Joining through a friend's invite link. The profile names who sent it,
      // which is the Memory Chain's link, and a private record made in the
      // same batch names the link itself (see joins below, which checks it).
      // So nobody can name someone as their inviter without one of their
      // links. The memory is named only if it's shared with everyone: a
      // link-only memory's address must not appear on a public profile.
      function validJoin(data) {
        let joined = getAfter(/databases/$(database)/documents/joins/$(uid)).data;
        let sent = get(/databases/$(database)/documents/invites/$(joined.inviteCode)).data;
        return data.invitedBy == joined.invitedBy
          && (sent.visibility == 'public'
              ? data.get('invitedVia', null) == sent.storyId
              : !('invitedVia' in data));
      }

      allow get: if true;
      allow list: if signedIn()
        && exists(/databases/$(database)/documents/usersPrivate/$(request.auth.uid))
        && request.query.limit <= 20;

      // Created together with the consent record, in one batch. Who invited
      // someone is set here, once, and can never be changed.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'nameLower', 'city', 'createdAt',
             'updatedAt', 'invitedBy', 'invitedVia'])
        && request.resource.data.keys().hasAll(['displayName', 'city', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == request.time
        && validProfile(request.resource.data)
        && existsAfter(/databases/$(database)/documents/usersPrivate/$(uid))
        && (!request.resource.data.keys().hasAny(['invitedBy', 'invitedVia'])
            || validJoin(request.resource.data));

      // People change their name, city and bio, and may take their photo
      // down, but only a moderator can put one up.
      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'nameLower', 'city', 'bio', 'photo', 'updatedAt'])
          && !('photo' in request.resource.data && request.resource.data.photo != resource.data.get('photo', null))
          && validProfile(request.resource.data))
        || validPhotoApproval(resource.data, request.resource.data)
        || validModeratorChange(resource.data, request.resource.data);

      allow delete: if isOwner(uid);
    }

    // A profile photo waiting for a moderator. The photo itself stays private
    // at Cloudinary until a moderator puts it up (users above). Only its
    // owner and moderators can see this. Must match src/lib/profiles.ts.
    match /photoReviews/{uid} {
      function validRequest(data) {
        return data.keys().hasOnly(['photoId', 'at', 'status'])
          && data.keys().hasAll(['photoId', 'at', 'status'])
          && data.photoId is string
          && data.photoId.matches('lss/avatars/' + uid + '/[A-Za-z0-9]{20}')
          && data.at == request.time
          && data.status == 'waiting';
      }

      // The moderator says why, and the person sees it.
      function validDecline(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['status', 'note', 'decidedAt'])
          && before.status == 'waiting'
          && after.status == 'declined'
          && isText(after.note, 5, 300)
          && after.decidedAt == request.time;
      }

      allow get: if isOwner(uid) || isModerator();
      allow list: if isModerator();
      allow create, update: if (isOwner(uid)
          && exists(/databases/$(database)/documents/usersPrivate/$(uid))
          && validRequest(request.resource.data))
        || (resource != null && validDecline(resource.data, request.resource.data));
      allow delete: if isOwner(uid) || isModerator();
    }

    // A report about someone's profile: their name, bio or photo. Each person
    // can report a profile once. Moderators read reports and close them; the
    // person never sees who reported them.
    match /profileReports/{reportId} {
      function profile(uid) {
        return /databases/$(database)/documents/users/$(uid);
      }

      // Must match PROFILE_REPORT_REASONS in src/lib/profiles.ts.
      function reasons() {
        return ['unkind', 'pretending', 'private', 'spam', 'other'];
      }

      function validReport(report) {
        return report.keys().hasOnly(['uid', 'reason', 'details', 'by', 'at', 'status'])
          && report.keys().hasAll(['uid', 'reason', 'by', 'at', 'status'])
          && report.uid is string
          && report.uid != request.auth.uid
          && reportId == report.uid + '_' + request.auth.uid
          && report.reason in reasons()
          && (report.reason == 'other'
              ? isText(report.get('details', null), 5, 500)
              : (!('details' in report) || isText(report.details, 1, 500)))
          && report.by == request.auth.uid
          && report.at == request.time
          && report.status == 'open'
          && exists(profile(report.uid));
      }

      // Closed once the profile is changed, kept after a look, or gone with
      // its account.
      function validClose(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['status', 'outcome', 'closedBy', 'closedAt'])
          && before.status == 'open'
          && after.status == 'closed'
          && after.closedBy == request.auth.uid
          && after.closedAt == request.time
          && (after.outcome == 'gone'
              ? !existsAfter(profile(before.uid))
              : after.outcome in ['kept', 'changed']);
      }

      allow create: if signedIn()
        && exists(/databases/$(database)/documents/usersPrivate/$(request.auth.uid))
        && validReport(request.resource.data);

      allow get: if isModerator();
      allow list: if isModerator() || (signedIn() && resource.data.by == request.auth.uid);
      allow update: if validClose(resource.data, request.resource.data);
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // Keeps bots and scripts from flooding the moderators: one new story a
    // minute and 10 in a rolling day per person. Written in the same batch as
    // each new story, which checks it. Must match src/lib/post-limits.ts.
    match /postLimits/{uid} {
      function validLimit(data) {
        return data.keys().hasOnly(['lastAt', 'windowStart', 'count'])
          && data.keys().hasAll(['lastAt', 'windowStart', 'count'])
          && data.lastAt == request.time
          && data.count is int;
      }

      allow get: if isOwner(uid);

      allow create: if isOwner(uid)
        && validLimit(request.resource.data)
        && request.resource.data.windowStart == request.time
        && request.resource.data.count == 1;

      allow update: if isOwner(uid)
        && validLimit(request.resource.data)
        && resource.data.lastAt + duration.value(1, 'm') <= request.time
        && ((resource.data.windowStart + duration.value(1, 'd') <= request.time
              && request.resource.data.windowStart == request.time
              && request.resource.data.count == 1)
          || (resource.data.windowStart + duration.value(1, 'd') > request.time
              && request.resource.data.windowStart == resource.data.windowStart
              && request.resource.data.count == resource.data.count + 1
              && request.resource.data.count <= 10));

      // Only when the whole account goes, with the consent record.
      allow delete: if isOwner(uid)
        && !existsAfter(/databases/$(database)/documents/usersPrivate/$(uid));
    }

    // Private consent record. Only its owner can read it.
    match /usersPrivate/{uid} {
      function validConsent(data) {
        return data.keys().hasOnly(['consentVersion', 'consentAt', 'ageConfirmed'])
          && data.keys().hasAll(['consentVersion', 'consentAt', 'ageConfirmed'])
          && data.consentVersion == currentConsentVersion()
          && data.ageConfirmed == true
          && data.consentAt == request.time;
      }

      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && validConsent(request.resource.data);
      allow delete: if isOwner(uid);

      // The memories this person loved before likes were public (see likes
      // below). Only they can see these, and nobody ever learns who loved a
      // memory. No new ones are made; each can still be taken back.
      match /reactions/{storyId} {
        function story() {
          return /databases/$(database)/documents/stories/$(storyId);
        }

        function loves(storyDoc) {
          return storyDoc.data.get('reactionCount', 0);
        }

        allow get, list: if isOwner(uid);

        // Taken back in the same batch as the memory's count (checked there
        // too). Once the memory is deleted there is no count left to change.
        allow delete: if isOwner(uid)
          && (!exists(story()) || loves(getAfter(story())) == loves(get(story())) - 1);
      }

      // Places this person saved, like bookmarks. Only they can see them;
      // nobody else learns who saved a memory. Only members who have given
      // consent can save.
      match /saved/{storyId} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid)
          && exists(/databases/$(database)/documents/usersPrivate/$(uid))
          && storyId.size() <= 40
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if isOwner(uid);
      }
    }

    // A memory of a store. The author creates it as pending; only a moderator
    // can change its status, and only an approved story is ever public.
    match /stories/{storyId} {
      function isAuthor() {
        return signedIn() && resource.data.authorId == request.auth.uid;
      }

      function optionalText(data, key, min, max) {
        return !(key in data) || isText(data[key], min, max);
      }

      // Must match CATEGORIES in src/lib/stories.ts.
      function categories() {
        return ['Restaurants', 'Cafes', 'Tea Stalls', 'Bakeries', 'School Canteens',
          'Kirana Stores', 'Bookstores', '₹10 Treats', 'Festival Memories',
          'Family Traditions', 'Local Legends', 'Stores We Miss'];
      }

      // Where the store was, for the map: a square of about 500 metres in
      // Hyderabad, never an exact spot. Must match src/lib/pins.ts.
      function validPin(pin) {
        return pin is map
          && pin.keys().hasOnly(['row', 'col'])
          && pin.keys().hasAll(['row', 'col'])
          && pin.row is int && pin.row >= 3822 && pin.row <= 3922
          && pin.col is int && pin.col >= 16638 && pin.col <= 16755;
      }

      // A post's photos or video at Cloudinary: up to five photos in order,
      // or one video, or one photo as posts had before. Must match photoId(),
      // photoIdAt() and videoId() in src/lib/server/photos.ts.
      function validMedia(data) {
        let base = 'lss/stories/' + request.auth.uid + '/' + storyId;
        let photos = [base + '/p1', base + '/p2', base + '/p3', base + '/p4', base + '/p5'];
        return data.keys().toSet().intersection(['photoId', 'photoIds', 'videoId'].toSet()).size() == 1
          && (!('photoId' in data) || data.photoId == base)
          && (!('photoIds' in data)
              || (data.photoIds is list
                  && data.photoIds.size() >= 1
                  && data.photoIds.size() <= 5
                  && data.photoIds == photos[0:data.photoIds.size()]))
          && (!('videoId' in data) || data.videoId == base + '/v');
      }

      function validNewStory(data) {
        return data.keys().hasOnly(['authorId', 'storeName', 'category', 'city',
            'neighbourhood', 'caption', 'year', 'ordered', 'visibility', 'rightsConfirmed',
            'status', 'photoId', 'photoIds', 'videoId', 'pin', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['authorId', 'storeName', 'category', 'city', 'caption',
            'visibility', 'rightsConfirmed', 'status', 'createdAt', 'updatedAt'])
          && data.authorId == request.auth.uid
          && isText(data.storeName, 2, 80)
          && data.category in categories()
          && isText(data.city, 2, 60)
          && optionalText(data, 'neighbourhood', 2, 60)
          && isText(data.caption, 10, 1000)
          && optionalText(data, 'ordered', 1, 80)
          && (!('year' in data)
              || (data.year is int && data.year >= 1940 && data.year <= request.time.year()))
          && data.visibility in ['public', 'link']
          && (!('pin' in data) || validPin(data.pin))
          && data.rightsConfirmed == true
          // Posts go up at once. Moderators act on reports (see validReportCount).
          // Older versions of the site still send 'pending', for a moderator to approve.
          && data.status in ['pending', 'approved']
          && validMedia(data)
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      // Where a moderator may move a story from each status.
      // Must match REVIEW_MOVES in src/lib/moderation.ts.
      function reviewMoves() {
        return {
          'pending': ['approved', 'rejected', 'hidden'],
          'approved': ['hidden'],
          'rejected': ['approved'],
          'hidden': ['approved']
        };
      }

      function logEntry(id) {
        return /databases/$(database)/documents/moderationLog/$(id);
      }

      // A moderator's decision. It changes only the review fields, and is
      // written to the moderation log in the same batch. It may start the
      // count of reports again (see validReportCount).
      function validReview(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewNote',
               'reviewLogId', 'updatedAt', 'reportCount'])
          && (!('reportCount' in after) || after.reportCount == before.reportCount)
          && after.status in reviewMoves().get(before.status, [])
          // The author is told why a story was not approved or was hidden.
          // Must match REVIEW_NOTE_MIN and REVIEW_NOTE_MAX in src/lib/moderation.ts.
          && (after.status == 'approved'
              ? !('reviewNote' in after)
              : isText(after.reviewNote, 5, 300))
          && after.reviewedAt == request.time
          && after.updatedAt == request.time
          && after.reviewLogId is string
          && !exists(logEntry(after.reviewLogId))
          && getAfter(logEntry(after.reviewLogId)).data.storyId == storyId
          && getAfter(logEntry(after.reviewLogId)).data.action == after.status;
      }

      // A moderator picks memories for the Featured row on the Wall, or
      // takes them out of it.
      function validFeature(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['featuredAt'])
          && (!('featuredAt' in after)
              || (after.featuredAt == request.time
                  && before.status == 'approved'
                  && before.visibility == 'public'));
      }

      // The author puts their memory on the map, moves its pin or takes it off.
      function validPinChange(before, after) {
        return isAuthor()
          && after.diff(before).affectedKeys().hasOnly(['pin', 'updatedAt'])
          && (!('pin' in after) || validPin(after.pin))
          && after.updatedAt == request.time;
      }

      function myReaction() {
        return /databases/$(database)/documents/usersPrivate/$(request.auth.uid)/reactions/$(storyId);
      }

      // Taking back a private love from before likes were public takes one
      // away from its count, in the same batch as deleting the love.
      function validReactionCount(before, after) {
        return signedIn()
          && after.diff(before).affectedKeys().hasOnly(['reactionCount'])
          && after.reactionCount == before.get('reactionCount', 0) - 1
          && exists(myReaction())
          && !existsAfter(myReaction());
      }

      function myLike() {
        return /databases/$(database)/documents/likes/$(storyId + '_' + request.auth.uid);
      }

      // Liking a memory adds one to its count and makes the person its
      // latest liker, in the same batch as their like (see likes below).
      // Someone who loved it privately before likes were public takes that
      // back first, so nobody is counted twice. Unliking takes one away, and
      // the latest liker is cleared if it was them.
      function validLike(before, after) {
        return signedIn()
          && after.diff(before).affectedKeys().hasOnly(['likeCount', 'lastLikerId'])
          && ((after.likeCount == before.get('likeCount', 0) + 1
                && before.status == 'approved'
                && after.lastLikerId == request.auth.uid
                && !exists(myLike())
                && existsAfter(myLike())
                && !exists(myReaction()))
            || (after.likeCount == before.get('likeCount', 0) - 1
                && exists(myLike())
                && !existsAfter(myLike())
                && (before.get('lastLikerId', null) == request.auth.uid
                    ? !('lastLikerId' in after)
                    : after.get('lastLikerId', null) == before.get('lastLikerId', null))));
      }

      // A comment added to the memory adds one to its count, and one taken
      // away takes one away, in the same batch. commentChange names that
      // comment, so the count only ever moves with a real one.
      function commentAt(id) {
        return /databases/$(database)/documents/comments/$(id);
      }

      function validCommentCount(before, after) {
        return signedIn()
          && after.diff(before).affectedKeys().hasOnly(['commentCount', 'commentChange'])
          && after.get('commentChange', null) is string
          && ((after.commentCount == before.get('commentCount', 0) + 1
                && before.status == 'approved'
                && !exists(commentAt(after.commentChange))
                && existsAfter(commentAt(after.commentChange))
                && getAfter(commentAt(after.commentChange)).data.storyId == storyId)
            || (after.commentCount == before.get('commentCount', 0) - 1
                && exists(commentAt(after.commentChange))
                && !existsAfter(commentAt(after.commentChange))
                && get(commentAt(after.commentChange)).data.storyId == storyId));
      }

      function myReport() {
        return /databases/$(database)/documents/reports/$(storyId + '_' + request.auth.uid);
      }

      // Reporting a post adds one to its count, in the same batch as the
      // report (see reports below). The third report takes the post off the
      // site, back to waiting, until a moderator looks. Taking back an open
      // report takes one away, so nobody counts twice by reporting again.
      // Must match REPORTS_TO_HOLD in src/lib/reports.ts.
      function validReportCount(before, after) {
        let count = before.get('reportCount', 0);
        return signedIn()
          && ((before.status == 'approved'
                && !exists(myReport())
                && existsAfter(myReport())
                && after.get('reportCount', null) == count + 1
                && (count + 1 >= 3
                    ? after.diff(before).affectedKeys().hasOnly(['reportCount', 'status'])
                        && after.status == 'pending'
                    : after.diff(before).affectedKeys().hasOnly(['reportCount'])))
            || (exists(myReport())
                && !existsAfter(myReport())
                && get(myReport()).data.status == 'open'
                && get(myReport()).data.get('counted', false) == true
                && after.diff(before).affectedKeys().hasOnly(['reportCount'])
                && after.get('reportCount', null) == count - 1));
      }

      // A moderator who looked at a post's reports and kept it up starts its
      // count again.
      function validReportReset(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['reportCount'])
          && !('reportCount' in after);
      }

      // Only people who have given consent can share, and each new story is
      // counted in postLimits in the same batch (see below).
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/usersPrivate/$(request.auth.uid))
        && validNewStory(request.resource.data)
        && getAfter(/databases/$(database)/documents/postLimits/$(request.auth.uid))
             .data.lastAt == request.time;

      // Anyone can open an approved story; the Wall lists only those shared
      // with everyone. Authors always see their own, moderators see all.
      allow get: if resource.data.status == 'approved' || isAuthor() || isModerator();
      allow list: if (resource.data.status == 'approved' && resource.data.visibility == 'public')
        || isAuthor()
        || isModerator();

      allow update: if validReview(resource.data, request.resource.data)
        || validFeature(resource.data, request.resource.data)
        || validReactionCount(resource.data, request.resource.data)
        || validLike(resource.data, request.resource.data)
        || validCommentCount(resource.data, request.resource.data)
        || validReportCount(resource.data, request.resource.data)
        || validReportReset(resource.data, request.resource.data)
        || validPinChange(resource.data, request.resource.data);
      allow delete: if isAuthor();
    }

    // Every moderation decision, for accountability. Moderators can read it;
    // nobody can change or delete an entry. The moderator's ID lives only
    // here, never on the story, so authors can't see who reviewed them.
    match /moderationLog/{logId} {
      function story(id) {
        return /databases/$(database)/documents/stories/$(id);
      }

      function validEntry(entry) {
        return entry.keys().hasOnly(['storyId', 'storeName', 'action', 'from', 'by', 'at', 'note'])
          && entry.keys().hasAll(['storyId', 'storeName', 'action', 'from', 'by', 'at'])
          && entry.storyId is string
          && entry.by == request.auth.uid
          && entry.at == request.time
          // Written together with the story's change (checked there too).
          && getAfter(story(entry.storyId)).data.reviewLogId == logId
          && entry.from == get(story(entry.storyId)).data.status
          && entry.storeName == getAfter(story(entry.storyId)).data.storeName
          && entry.get('note', null) == getAfter(story(entry.storyId)).data.get('reviewNote', null);
      }

      allow get, list: if isModerator();
      allow create: if isModerator() && validEntry(request.resource.data);
    }

    // A report about a memory on the Wall. Each person can report a memory
    // once. Moderators read reports and close them; the memory's author never
    // sees who reported it.
    match /reports/{reportId} {
      function story(id) {
        return /databases/$(database)/documents/stories/$(id);
      }

      // Must match REPORT_REASONS in src/lib/reports.ts.
      function reasons() {
        return ['unkind', 'private', 'notStore', 'rights', 'other'];
      }

      // The post's count of reports, before and after this request.
      function countBefore(id) {
        return get(story(id)).data.get('reportCount', 0);
      }

      function countAfter(id) {
        return getAfter(story(id)).data.get('reportCount', 0);
      }

      // Must match REPORT_DETAILS_MIN and REPORT_DETAILS_MAX in src/lib/reports.ts.
      function validReport(report) {
        return report.keys()
            .hasOnly(['storyId', 'reason', 'details', 'by', 'at', 'status', 'counted'])
          && report.keys().hasAll(['storyId', 'reason', 'by', 'at', 'status', 'counted'])
          && report.storyId is string
          && reportId == report.storyId + '_' + request.auth.uid
          && report.reason in reasons()
          // "Something else" needs a few words; other reasons may add some.
          && (report.reason == 'other'
              ? isText(report.get('details', null), 5, 500)
              : (!('details' in report) || isText(report.details, 1, 500)))
          && report.by == request.auth.uid
          && report.at == request.time
          && report.status == 'open'
          && get(story(report.storyId)).data.status == 'approved'
          // Counted on the post in the same batch (see validReportCount).
          && report.counted == true
          && countAfter(report.storyId) == countBefore(report.storyId) + 1;
      }

      // A moderator closes a report once the memory is hidden, kept up after
      // a look, or gone because its author deleted it.
      function validClose(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['status', 'outcome', 'closedBy', 'closedAt'])
          && before.status == 'open'
          && after.status == 'closed'
          && after.closedBy == request.auth.uid
          && after.closedAt == request.time
          && (after.outcome == 'gone'
              ? !existsAfter(story(before.storyId))
              : (after.outcome in ['hidden', 'kept']
                 && getAfter(story(before.storyId)).data.status
                      == (after.outcome == 'hidden' ? 'hidden' : 'approved')));
      }

      // Only people who have given consent can report.
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/usersPrivate/$(request.auth.uid))
        && validReport(request.resource.data);

      // People can find and take back their own reports, for example when
      // they delete their account. Taking back an open report that was
      // counted on its post takes one off the count in the same batch.
      allow get: if isModerator();
      allow list: if isModerator() || (signedIn() && resource.data.by == request.auth.uid);
      allow update: if validClose(resource.data, request.resource.data);
      allow delete: if signedIn() && resource.data.by == request.auth.uid
        && (resource.data.status != 'open'
            || resource.data.get('counted', false) != true
            || !existsAfter(story(resource.data.storyId))
            || countAfter(resource.data.storyId) == countBefore(resource.data.storyId) - 1);
    }

    // Who liked which memory. Likes are public, as on Instagram: anyone can
    // see who liked a memory. The ID is the memory's ID, then the person's,
    // so nobody likes the same memory twice. Each like moves the memory's
    // count in the same batch (checked there too).
    match /likes/{likeId} {
      function story(id) {
        return /databases/$(database)/documents/stories/$(id);
      }

      function likes(storyDoc) {
        return storyDoc.data.get('likeCount', 0);
      }

      // The memory's author deletes every like with the memory itself.
      function goesWithStory(id) {
        return exists(story(id))
          && get(story(id)).data.authorId == request.auth.uid
          && !existsAfter(story(id));
      }

      allow get, list: if true;

      // Only people who have given consent can like.
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/usersPrivate/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['storyId', 'uid', 'at'])
        && request.resource.data.keys().hasAll(['storyId', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.storyId is string
        && likeId == request.resource.data.storyId + '_' + request.auth.uid
        && request.resource.data.at == request.time
        && likes(getAfter(story(request.resource.data.storyId)))
             == likes(get(story(request.resource.data.storyId))) + 1;

      // Unliking. Once the memory is deleted there is no count left to change.
      allow delete: if signedIn()
        && ((resource.data.uid == request.auth.uid
              && (!exists(story(resource.data.storyId))
                  || likes(getAfter(story(resource.data.storyId)))
                       == likes(get(story(resource.data.storyId))) - 1))
          || goesWithStory(resource.data.storyId));
    }

    // Comments under a memory. They show at once, to anyone who can see the
    // memory. Their author, the memory's author and moderators can delete
    // them, and anyone can report one (see commentReports below).
    match /comments/{commentId} {
      function story(id) {
        return /databases/$(database)/documents/stories/$(id);
      }

      function profile(uid) {
        return /databases/$(database)/documents/users/$(uid);
      }

      function count(storyDoc) {
        return storyDoc.data.get('commentCount', 0);
      }

      // Written with the memory's count and commentChange (checked there too).
      function counted(id, change) {
        return count(getAfter(story(id))) == count(get(story(id))) + change
          && getAfter(story(id)).data.commentChange == commentId;
      }

      // Must match COMMENT_MAX in src/lib/comments.ts.
      function validComment(data) {
        return data.keys().hasOnly(['storyId', 'authorId', 'text', 'createdAt'])
          && data.keys().hasAll(['storyId', 'authorId', 'text', 'createdAt'])
          && data.authorId == request.auth.uid
          && data.storyId is string
          && isText(data.text, 1, 500)
          && data.text.trim().size() > 0
          && noLinks(data.text)
          && data.createdAt == request.time;
      }

      // Nobody can comment on the memories of someone who blocked them.
      function blockedBy(uid) {
        return exists(/databases/$(database)/documents/blocks/$(uid + '_' + request.auth.uid));
      }

      // The memory's author deletes every comment with the memory itself.
      function goesWithStory(id) {
        return exists(story(id))
          && get(story(id)).data.authorId == request.auth.uid
          && !existsAfter(story(id));
      }

      function mayRemove(data) {
        return data.authorId == request.auth.uid
          || isModerator()
          || (exists(story(data.storyId)) && get(story(data.storyId)).data.authorId == request.auth.uid);
      }

      // Anyone may read the comments of an approved memory. Their authors,
      // the memory's author and moderators may read them whatever happens to
      // the memory, to tidy them away.
      allow get, list: if get(story(resource.data.storyId)).data.status == 'approved'
        || (signedIn()
            && (resource.data.authorId == request.auth.uid
                || isModerator()
                || get(story(resource.data.storyId)).data.authorId == request.auth.uid));

      // People who have given consent and have a profile comment on an
      // approved memory, a few a minute (commentLimits below, in the same
      // batch).
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/usersPrivate/$(request.auth.uid))
        && exists(profile(request.auth.uid))
        && validComment(request.resource.data)
        && get(story(request.resource.data.storyId)).data.status == 'approved'
        && !blockedBy(get(story(request.resource.data.storyId)).data.authorId)
        && counted(request.resource.data.storyId, 1)
        && getAfter(/databases/$(database)/documents/commentLimits/$(request.auth.uid))
             .data.lastAt == request.time;

      allow delete: if signedIn()
        && ((mayRemove(resource.data)
              && (!exists(story(resource.data.storyId)) || counted(resource.data.storyId, -1)))
          || goesWithStory(resource.data.storyId));
    }

    // Keeps bots from flooding memories with comments: one every 10 seconds
    // and 100 in a rolling day per person. Written in the same batch as each
    // new comment, which checks it. Must match src/lib/comments.ts.
    match /commentLimits/{uid} {
      function validLimit(data) {
        return data.keys().hasOnly(['lastAt', 'windowStart', 'count'])
          && data.keys().hasAll(['lastAt', 'windowStart', 'count'])
          && data.lastAt == request.time
          && data.count is int;
      }

      allow get: if isOwner(uid);

      allow create: if isOwner(uid)
        && validLimit(request.resource.data)
        && request.resource.data.windowStart == request.time
        && request.resource.data.count == 1;

      allow update: if isOwner(uid)
        && validLimit(request.resource.data)
        && resource.data.lastAt + duration.value(10, 's') <= request.time
        && ((resource.data.windowStart + duration.value(1, 'd') <= request.time
              && request.resource.data.windowStart == request.time
              && request.resource.data.count == 1)
          || (resource.data.windowStart + duration.value(1, 'd') > request.time
              && request.resource.data.windowStart == resource.data.windowStart
              && request.resource.data.count == resource.data.count + 1
              && request.resource.data.count <= 100));

      // Only when the whole account goes, with the consent record.
      allow delete: if isOwner(uid)
        && !existsAfter(/databases/$(database)/documents/usersPrivate/$(uid));
    }

    // A report about a comment. Each person can report a comment once.
    // Moderators read reports and close them; the comment's author never
    // sees who reported it.
    match /commentReports/{reportId} {
      function comment(id) {
        return /databases/$(database)/documents/comments/$(id);
      }

      // Must match COMMENT_REPORT_REASONS in src/lib/comments.ts.
      function reasons() {
        return ['unkind', 'private', 'spam', 'other'];
      }

      function validReport(report) {
        return report.keys().hasOnly(['commentId', 'storyId', 'reason', 'details', 'by', 'at', 'status'])
          && report.keys().hasAll(['commentId', 'storyId', 'reason', 'by', 'at', 'status'])
          && report.commentId is string
          && reportId == report.commentId + '_' + request.auth.uid
          && report.reason in reasons()
          && (report.reason == 'other'
              ? isText(report.get('details', null), 5, 500)
              : (!('details' in report) || isText(report.details, 1, 500)))
          && report.by == request.auth.uid
          && report.at == request.time
          && report.status == 'open'
          && get(comment(report.commentId)).data.storyId == report.storyId;
      }

      // A moderator closes a report once the comment is deleted, or kept
      // after a look.
      function validClose(before, after) {
        return isModerator()
          && after.diff(before).affectedKeys().hasOnly(['status', 'outcome', 'closedBy', 'closedAt'])
          && before.status == 'open'
          && after.status == 'closed'
          && after.closedBy == request.auth.uid
          && after.closedAt == request.time
          && (after.outcome == 'gone'
              ? !existsAfter(comment(before.commentId))
              : (after.outcome == 'kept' && existsAfter(comment(before.commentId))));
      }

      allow create: if signedIn()
        && exists(/databases/$(database)/documents/usersPrivate/$(request.auth.uid))
        && validReport(request.resource.data);

      allow get: if isModerator();
      allow list: if isModerator() || (signedIn() && resource.data.by == request.auth.uid);
      allow update: if validClose(resource.data, request.resource.data);
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // A memory's invite link, /invite/{code}, to pass it on. Each memory has
    // one, and any number of friends can join through it, including people
    // it's forwarded to. The code is random, so only people who were sent
    // the link can use it.
    match /invites/{code} {
      function story(id) {
        return /databases/$(database)/documents/stories/$(id);
      }

      function inviteSet(storyId) {
        return /databases/$(database)/documents/inviteSets/$(storyId);
      }

      // Anyone with the link can open it. It never says who joined through
      // it. (Invites from before shared links worked once. A used one stays
      // visible only to its sender and the person who used it.)
      allow get: if resource == null
        || !('usedBy' in resource.data)
        || (signedIn() && request.auth.uid in [resource.data.from, resource.data.usedBy]);
      allow list: if signedIn() && resource.data.from == request.auth.uid;

      // Made for the author's own memory, together with the memory's invite
      // set (below), which can only be made once. It says whether the memory
      // is shared with everyone (checked there too).
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/usersPrivate/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['from', 'storyId', 'visibility', 'createdAt'])
        && request.resource.data.keys().hasAll(['from', 'storyId', 'visibility', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.storyId is string
        && request.resource.data.createdAt == request.time
        && !exists(inviteSet(request.resource.data.storyId))
        && code in getAfter(inviteSet(request.resource.data.storyId)).data.codes;

      // Taken back once the memory is gone, when its author deletes it or
      // their account.
      allow delete: if signedIn()
        && resource.data.from == request.auth.uid
        && !exists(story(resource.data.storyId));
    }

    // The code of a memory's invite link. It can be made only once, so a
    // memory never has more than one link. (Memories shared before shared
    // links have three.) Only its author can find it.
    match /inviteSets/{storyId} {
      function story() {
        return /databases/$(database)/documents/stories/$(storyId);
      }

      function madeNow(code) {
        let made = getAfter(/databases/$(database)/documents/invites/$(code)).data;
        return made.storyId == storyId && made.visibility == get(story()).data.visibility;
      }

      allow list: if signedIn() && resource.data.from == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'codes', 'createdAt'])
        && request.resource.data.keys().hasAll(['from', 'codes', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.createdAt == request.time
        && get(story()).data.authorId == request.auth.uid
        && request.resource.data.codes is list
        && request.resource.data.codes.size() == 1
        && madeNow(request.resource.data.codes[0]);

      allow delete: if signedIn()
        && resource.data.from == request.auth.uid
        && !exists(story());
    }

    // Which invite link someone joined through, and who sent it. Only they
    // and that friend can see it: their public profile names the friend, but
    // never the link.
    match /joins/{uid} {
      function profile() {
        return /databases/$(database)/documents/users/$(uid);
      }

      // The link must be that friend's, not their own, for a memory that
      // still exists. (A used invite from before shared links stays used.)
      function validLink(data) {
        let sent = get(/databases/$(database)/documents/invites/$(data.inviteCode)).data;
        return sent.from == data.invitedBy
          && sent.from != uid
          && !('usedBy' in sent)
          && exists(/databases/$(database)/documents/stories/$(sent.storyId));
      }

      allow get: if isOwner(uid)
        || (signedIn() && resource.data.invitedBy == request.auth.uid);
      allow list: if signedIn() && resource.data.invitedBy == request.auth.uid;

      // Made once, in the same batch that creates their profile, which names
      // the same friend.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['inviteCode', 'invitedBy', 'joinedAt'])
        && request.resource.data.keys().hasAll(['inviteCode', 'invitedBy', 'joinedAt'])
        && request.resource.data.joinedAt == request.time
        && !exists(profile())
        && getAfter(profile()).data.get('invitedBy', null) == request.resource.data.invitedBy
        && validLink(request.resource.data);

      // Only together with their profile, when they delete their account.
      allow delete: if isOwner(uid) && !existsAfter(profile());
    }

    // Who follows whom. As on Instagram, anyone can see someone's followers
    // and who they follow. The ID is the follower's user ID, then the
    // followed person's, so nobody follows the same person twice.
    match /follows/{followId} {
      function profile(uid) {
        return /databases/$(database)/documents/users/$(uid);
      }

      function hasBlocked(blocker, blocked) {
        return exists(/databases/$(database)/documents/blocks/$(blocker + '_' + blocked));
      }

      allow get, list: if true;

      // Someone with a profile follows someone else with one, unless either
      // has blocked the other. People joining through an invite link follow
      // its sender in the same batch that creates their profile.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.keys().hasAll(['from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.createdAt == request.time
        && existsAfter(profile(request.auth.uid))
        && exists(profile(request.resource.data.to))
        && !hasBlocked(request.resource.data.to, request.auth.uid)
        && !hasBlocked(request.auth.uid, request.resource.data.to);

      // Unfollowing, or removing a follower. (Deleting a follow that isn't
      // there changes nothing, so blocking can always clear both ways.)
      allow delete: if signedIn()
        && (resource == null || request.auth.uid in [resource.data.from, resource.data.to]);
    }

    // Whom someone has blocked. Only they can see it. Blocking ends any
    // follow between the two, in the same batch, and stops new ones.
    match /blocks/{blockId} {
      function follow(from, to) {
        return /databases/$(database)/documents/follows/$(from + '_' + to);
      }

      allow get: if signedIn() && blockId.split('_')[0] == request.auth.uid;
      allow list: if signedIn() && resource.data.from == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.keys().hasAll(['from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !existsAfter(follow(request.resource.data.to, request.auth.uid))
        && !existsAfter(follow(request.auth.uid, request.resource.data.to));

      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // The bell at the top of the page: when someone last followed this
    // person, and when they last looked. Only they can read it.
    match /bells/{uid} {
      function followedNow() {
        let follow = /databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid);
        return !exists(follow) && existsAfter(follow);
      }

      allow get: if isOwner(uid);

      // They mark it seen when they open their activity.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['seenAt'])
        && request.resource.data.seenAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
        && request.resource.data.seenAt == request.time;

      // Anyone else rings it only in the same batch as following them.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ringAt'])
        && request.resource.data.ringAt == request.time
        && followedNow();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ringAt'])
        && request.resource.data.ringAt == request.time
        && followedNow();

      allow delete: if isOwner(uid);
    }
  }
}
